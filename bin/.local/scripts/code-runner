#!/usr/bin/env bash

file=$(find . -type f -printf "%T@ %p\n" | sort -n | tail -1 | cut -d' ' -f2-)
extension="${file##*.}"

if [ "$file" = "Cargo.toml" ]; then
    echo "Cargo.toml was modified. Running cargo build..."
    cargo build
    exit 0
fi

case "$extension" in
c)
    echo "Compiling C file: $file"
    gcc "$file" && ./a.out
    ;;
cpp)
    echo "Compiling C++ file: $file"
    g++ "$file" && ./a.out
    ;;
js)
    echo "Running js file: $file"
    node "$file"
    ;;
rs)
    echo "Running Rust project: $file"
    cargo run
    ;;
*)
    echo "Damn it! got the wrong file in the buffer: .$extension"
    ;;
esac
